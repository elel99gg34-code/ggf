{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalBiseo",
  "mainBinaryName": "LocalBiseo",
  "version": "0.1.0",
  "identifier": "kr.localbiseo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "로컬비서",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "인터넷 없이 내 PC에서 도는 업무 비서",
    "longDescription": "녹음 → 회의록, 문서 속 개인정보 자동 가림, 이미지·영상 일괄 처리와 비서 기능 13가지. 모든 처리는 PC 안에서만 이뤄집니다.",
    "copyright": "© 2026 로컬비서",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Korean"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
